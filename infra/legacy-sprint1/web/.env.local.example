# =============================================================================
# Sprint 1 — Variáveis do Painel Next.js
# Copie para `.env.local` dentro da pasta web/:
#   cp .env.local.example .env.local
# =============================================================================

# URL do projeto Supabase (a mesma usada pelo n8n)
# Ex: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon key (PÚBLICA — somente leitura via RLS). Encontre em:
# Supabase > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
