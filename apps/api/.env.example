# API (Express) — copie para apps/api/.env em desenvolvimento local (fora do Docker)
NODE_ENV=development
API_PORT=3333
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://whatsboot:whatsboot@localhost:5432/whatsboot?schema=public

# Redis é OPCIONAL. Deixe COMENTADO para rodar tudo em processo (filas inline +
# Socket.IO local) — recomendado em dev. Só defina com um Redis >= 5 para escalar
# com worker separado. (Redis < 5 NÃO é suportado pelo BullMQ.)
# REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
