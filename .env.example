# =============================================================================
# Sprint 1 — Variáveis de ambiente (INFRAESTRUTURA / docker-compose)
# Copie este arquivo para `.env` e preencha os valores.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (interno do Evolution API)
# -----------------------------------------------------------------------------
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evolution
POSTGRES_DB=evolution

# -----------------------------------------------------------------------------
# Evolution API
# -----------------------------------------------------------------------------
# Chave global usada no header `apikey` de toda chamada à Evolution.
# Gere algo aleatório, ex: openssl rand -hex 16
EVOLUTION_API_KEY=troque-esta-chave-evolution
# URL pública do servidor Evolution
EVOLUTION_SERVER_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
N8N_HOST=localhost
# URL base usada pelo n8n para montar os webhooks de PRODUÇÃO
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Supabase (nuvem) — usadas pelo n8n para gravar via REST
# Encontre em: Supabase > Project Settings > API
# -----------------------------------------------------------------------------
# Ex: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# service_role key (SECRETA — só no servidor/n8n, NUNCA no frontend)
SUPABASE_SERVICE_ROLE_KEY=
