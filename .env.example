# =============================================================================
# whats-boot — Variáveis de ambiente (infraestrutura)
# Copie para `.env`:  cp .env.example .env
# =============================================================================

# ----- Ambiente -----
NODE_ENV=development
TZ=America/Sao_Paulo

# ----- API (Express) -----
API_PORT=3333
API_HOST=0.0.0.0
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ----- PostgreSQL -----
POSTGRES_USER=whatsboot
POSTGRES_PASSWORD=whatsboot
POSTGRES_DB=whatsboot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# String usada pelo Prisma (host "postgres" dentro do Docker; "localhost" fora)
DATABASE_URL=postgresql://whatsboot:whatsboot@postgres:5432/whatsboot?schema=public

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# ----- Autenticação (placeholders — ETAPA 4) -----
JWT_ACCESS_SECRET=troque-esta-chave-de-access
JWT_REFRESH_SECRET=troque-esta-chave-de-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ----- Rate limit -----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ----- Frontend (Vite) -----
# Estas precisam do prefixo VITE_ para chegarem ao browser
VITE_API_URL=http://localhost:3333
VITE_SOCKET_URL=http://localhost:3333
